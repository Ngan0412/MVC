@{
    ViewData["Title"] = "Trang cá nhân tối ưu hiệu năng";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-sm border-0 text-center p-4 mb-4 bg-white">
                <div class="mb-3">
                    <img src="@User.FindFirst("AvatarUrl")?.Value" class="rounded-circle border border-3 border-warning" style="width: 100px; height: 100px; object-fit: cover;" alt="Avatar" />
                </div>
                <h4 class="mb-1">@User.FindFirst("FullName")?.Value</h4>
                <p class="text-muted small">@User.Identity?.Name</p>
                <div>
                    <span class="badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill">
                        <i class="bi bi-gem me-1"></i> Chức danh: @User.FindFirst("MemberLevel")?.Value
                    </span>
                </div>
            </div>

            <div class="card border-dark shadow-sm">
                <div class="card-header bg-dark text-white fw-bold">
                    ⏱️ Báo Cáo Hiệu Năng Xử Lý Của Server (Benchmark)
                </div>
                <div class="card-body">
                    <p class="text-muted small">Mỗi khi bạn bấm F5 (Tải lại trang), hãy quan sát độ chênh lệch thời gian xử lý giữa 2 cơ chế:</p>

                    <div class="table-responsive">
                        <table class="table table-bordered align-middle text-center mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Cơ Chế Xử Lý</th>
                                    <th>Thời Gian Phản Hồi</th>
                                    <th>Đánh Giá</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="table-danger">
                                    <td class="text-start"><strong>Cách 1:</strong> Gọi lệnh SQL xuống Database</td>
                                    <td class="font-monospace fw-bold text-danger">@ViewBag.DbTime ms</td>
                                    <td class="small text-muted">Chậm vì phải đọc ổ đĩa, dễ nghẽn khi web đông người</td>
                                </tr>
                                <tr class="table-success">
                                    <td class="text-start"><strong>Cách 2:</strong> Bốc dữ liệu từ Claims (RAM)</td>
                                    <td class="font-monospace fw-bold text-success">@ViewBag.RamTime ms</td>
                                    <td class="small text-success fw-bold">⚡ Gần như bằng 0 ms (Tức thời)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="alert alert-info mt-3 mb-0 small">
                        💡 <strong>Kết luận thực nghiệm:</strong> Đọc dữ liệu từ <strong>Claims trên RAM</strong> nhanh hơn cách gọi Database từ <strong>10 đến 50 lần</strong>. Khi website đạt quy mô lớn, việc giảm tải các lệnh SQL hiển thị này giúp Database hoàn toàn giải phóng, không bao giờ lo bị treo hay sập trang!
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>