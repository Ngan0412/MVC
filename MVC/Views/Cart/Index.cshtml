@model MVC.Models.OrderDetailsViewModel

@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.OrderCode;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark">Đơn hàng #@Model.OrderCode</h2>
            <p class="text-muted mb-0">Ngày đặt: @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
        <div>
            @if (Model.Status == "Đã giao")
            {
                <span class="badge bg-success fs-6 px-3 py-2">Đã giao hàng thành công</span>
            }
            else if (Model.Status == "Đang giao")
            {
                <span class="badge bg-warning text-dark fs-6 px-3 py-2">Đang vận chuyển</span>
            }
            else
            {
                <span class="badge bg-secondary fs-6 px-3 py-2">@Model.Status</span>
            }
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">

            <div class="card shadow-sm mb-4 border-0">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-3">Trạng thái xử lý</h5>
                    <div class="d-flex justify-content-between text-center position-relative my-4">
                        <div class="w-100 position-absolute top-50 start-0 translate-middle-y bg-light" style="height: 4px; z-index: 0;"></div>
                        <div class="text-success position-relative" style="z-index: 1;">
                            <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 40px; height: 40px;"><i class="bi bi-check-lg"></i></div>
                            <p class="small fw-bold mb-0">Chờ xác nhận</p>
                        </div>
                        <div class="text-success position-relative" style="z-index: 1;">
                            <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 40px; height: 40px;"><i class="bi bi-box-seam"></i></div>
                            <p class="small fw-bold mb-0">Đóng gói</p>
                        </div>
                        <div class="text-warning position-relative" style="z-index: 1;">
                            <div class="bg-warning text-dark rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 40px; height: 40px;"><i class="bi bi-truck"></i></div>
                            <p class="small fw-bold mb-0">Đang giao</p>
                        </div>
                        <div class="text-muted position-relative" style="z-index: 1;">
                            <div class="bg-light text-muted rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 40px; height: 40px;"><i class="bi bi-house-door"></i></div>
                            <p class="small mb-0">Đã nhận</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-0">
                    <div class="p-3 border-bottom">
                        <h5 class="card-title fw-bold mb-0">Sản phẩm đã mua (@Model.OrderItems.Count)</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-borderless align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3" style="width: 50%;">Sản phẩm</th>
                                    <th class="text-center">Giá lẻ</th>
                                    <th class="text-center">Số lượng</th>
                                    <th class="text-end pe-3">Tạm tính</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <div class="d-flex align-items-center">
                                                <img src="@item.ProductImage" alt="@item.ProductName" class="rounded me-3 border" style="width: 60px; height: 60px; object-fit: cover;" />
                                                <div>
                                                    <h6 class="mb-0 fw-bold">@item.ProductName</h6>
                                                    <small class="text-muted">Mã SP: @item.ProductId</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">@item.Price.ToString("N0") đ</td>
                                        <td class="text-center">x@item.Quantity</td>
                                        <td class="text-end pe-3 fw-bold text-dark">@item.Total.ToString("N0") đ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-3">Thông tin nhận hàng</h5>
                    <hr />
                    <p class="mb-1 fw-bold"><i class="bi bi-person me-2 text-muted"></i>@Model.CustomerName</p>
                    <p class="mb-1"><i class="bi bi-telephone me-2 text-muted"></i>@Model.Phone</p>
                    <p class="mb-3"><i class="bi bi-geo-alt me-2 text-muted"></i>@Model.ShippingAddress</p>

                    <span class="badge bg-light text-dark border w-100 p-2 text-start">
                        <i class="bi bi-credit-card me-2"></i>Phương thức: @Model.PaymentMethod
                    </span>
                </div>
            </div>

            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-3">Tổng kết đơn hàng</h5>
                    <hr />
                    @{
                        decimal subTotal = Model.OrderItems.Sum(x => x.Total);
                    }
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tạm tính:</span>
                        <span>@subTotal.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Phí vận chuyển:</span>
                        <span>@Model.ShippingFee.ToString("N0") đ</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fw-bold fs-5">Tổng cộng:</span>
                        <span class="fw-bold fs-4 text-danger">@Model.TotalAmount.ToString("N0") đ</span>
                    </div>

                    <div class="d-grid gap-2">
                        <a href="@Url.Action("Index", "Order")" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-2"></i>Quay lại danh sách
                        </a>
                        @if (Model.Status == "Chờ duyệt")
                        {
                            <button class="btn btn-danger" onclick="cancelOrder(@Model.OrderId)">Hủy đơn hàng</button>
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

